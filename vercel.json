{
  "rewrites": [
    {
      "source": "/api/stock/fundamentals",
      "destination": "/api/fundamentals.py"
    },
    {
      "source": "/api/stock/search",
      "destination": "/api/stock-search.py"
    },
    {
      "source": "/api/stock",
      "destination": "/api/stock.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
